{% set customer = customer ?? signals.customer ?? null %}
{% set customerHandle = customer ? customer|replace({ '-': ' ', '@': ' ', '.' : ' ' })|camel : 'all' %}
{% set namespace = 'sales.' ~ customerHandle %}

{% set start = customer ? null : (start ?? signals.start ?? null) %}
{% set end = customer ? null : (end ?? signals.end ?? null) %}
{% set orderBy = signals.sales[customerHandle].orderBy %}
{% set sortBy = signals.sales[customerHandle].sortBy %}
{% set offset = signals.sales[customerHandle].offset %}
{% set offset = offset > 0 ? offset : 0 %}
{% set limit = signals.sales[customerHandle].limit %}
{% set search = signals.sales[customerHandle].search %}
{% set sales = craft.pluginSales.reports.getSalesData(customer, start, end, orderBy, sortBy, offset, limit, search) %}
{% set total = craft.pluginSales.reports.getSalesCount(customer, start, end, search) %}
{% set maxVisible = sales|length + offset %}

{% do signals.set('sales.' ~ customerHandle ~ '.total', total) %}
{% do signals.set('sales.' ~ customerHandle ~ '.maxVisible', maxVisible) %}

{% fragment %}
    {{ include('plugin-sales/_includes/sales-results') }}
{% endfragment %}

{% if not customer %}
    {% fragment with { mergeMode: 'upsertAttributes' } %}
        <div id="sales" data-scroll-into-view__vstart></div>
    {% endfragment %}
{% endif %}
