{% set customer = customer ?? signals.customer ?? null %}
{% set salesType = customer ? 'customer' : 'all' %}
{% set namespace = '$sales.' ~ salesType %}

{% set start = customer ? null : (start ?? signals.start ?? null) %}
{% set end = customer ? null : (end ?? signals.end ?? null) %}
{% set limit = signals.sales[salesType].limit %}
{% set search = signals.sales[salesType].search %}
{% set orderBy = signals.sales[salesType].orderBy %}
{% set sortBy = signals.sales[salesType].sortBy %}
{% set offset = offset ?? 0 %}
{% set sales = craft.pluginSales.reports.getSalesData(customer, start, end, orderBy, sortBy, offset, limit, search) %}
{% set total = craft.pluginSales.reports.getSalesCount(customer, start, end, search) %}
{% set maxVisible = sales|length + offset %}

{% fragment %}
    {{ include('plugin-sales/_includes/sales-results') }}
{% endfragment %}
