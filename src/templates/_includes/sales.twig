{% set customer = customer ?? null %}
{% set salesType = customer ? 'customer' : 'all' %}
{% set namespace = '$sales.' ~ salesType %}

{% set start = start ?? null %}
{% set end = end ?? null %}
{% set orderBy = 'dateSold' %}
{% set sortBy = 'desc' %}
{% set offset = 0 %}
{% set limit = 10 %}
{% set search = '' %}
{% set sales = craft.pluginSales.reports.getSalesData(customer, start, end, orderBy, sortBy, offset, limit, search) %}
{% set total = craft.pluginSales.reports.getSalesCount(customer, start, end, search) %}
{% set maxVisible = sales|length + offset %}

{% set signals = {
    customer: customer,
    sales: {
        (salesType): {
            limit: limit,
            search: search,
            orderBy: orderBy,
            sortBy: sortBy,
        },
    },
} %}

<div data-signals="{{ datastar.signals(signals) }}" class="set-table flex">
    <div class="select">
        <select data-bind="{{ namespace }}.limit" data-on-change="{{ datastar.get('plugin-sales/_datastar/sales') }}" data-indicator-fetching.sales.{{ customer ? 'customer' : 'all' }}>
            <option value="10">10</option>
            <option value="25">25</option>
            <option value="50">50</option>
            <option value="100">100</option>
        </select>
    </div>
    sales displayed
    <div class="search-container toolbar flex-grow texticon has-filter-btn">
        <span class="texticon-icon search icon" aria-hidden="true"></span>
        <input data-bind="{{ namespace }}.search" data-on-keydown__debounce.400ms="{{ datastar.get('plugin-sales/_datastar/sales') }}" data-indicator-fetching.sales.{{ customer ? 'customer'  : 'all' }} type="text" class="clearable text fullwidth" autocomplete="off" placeholder="Search">
    </div>
</div>

{{ include('plugin-sales/_includes/sales-results') }}
