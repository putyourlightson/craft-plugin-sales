{% set customer = customer ?? null %}
{% set customerHandle = customer ? customer|replace({ '-': ' ', '@': ' ', '.' : ' ' })|camel : 'all' %}
{% set namespace = 'sales.' ~ customerHandle %}

{% set start = start ?? null %}
{% set end = end ?? null %}
{% set orderBy = 'dateSold' %}
{% set sortBy = 'desc' %}
{% set offset = 0 %}
{% set offset = offset > 0 ? offset : 0 %}
{% set limit = 10 %}
{% set search = '' %}
{% set sales = craft.pluginSales.reports.getSalesData(customer, start, end, orderBy, sortBy, offset, limit, search) %}
{% set total = craft.pluginSales.reports.getSalesCount(customer, start, end, search) %}
{% set maxVisible = sales|length + offset %}

{% set signals = {
    customer: customer,
    customerHandle: customerHandle,
    sales: {
        (customerHandle): {
            offset: offset,
            limit: limit,
            search: search,
            orderBy: orderBy,
            sortBy: sortBy,
            maxVisible: maxVisible,
            total: total,
        },
    },
} %}

<div data-signals="{{ signals|json_encode }}" class="set-table flex">
    <div class="select">
        <select data-bind="{{ namespace }}.limit" data-on-change="{{ namespace }}.offset.value = 0; {{ datastar.sse('plugin-sales/_datastar/sales') }}" data-indicator-fetching-sales>
            <option value="10">10</option>
            <option value="25">25</option>
            <option value="50">50</option>
            <option value="100">100</option>
        </select>
    </div>
    sales displayed
    <div class="search-container flex-grow texticon has-filter-btn">
        <span class="texticon-icon search icon" aria-hidden="true"></span>
        <input data-bind="{{ namespace }}.search" data-on-keydown__debounce.400ms="{{ namespace }}.offset.value = 0; {{ datastar.sse('plugin-sales/_datastar/sales') }}" data-indicator-fetching-sales type="text" class="clearable text fullwidth" autocomplete="off" placeholder="Search">
    </div>
</div>

<div class="elements" data-class="{'busy': fetchingSales.value}" style="margin-top: 1rem;">
    <div id="sales-indicator" class="update-spinner spinner spinner-absolute"></div>
    <table class="data fullwidth">
        <thead>
            <tr>
                {% if customer is empty %}
                    <th class="orderable" data-class="{'ordered': {{ namespace }}.orderBy.value == 'customer', 'desc': {{ namespace }}.sortBy.value == 'desc'}">
                        <button data-on-click="{{ namespace }}.sortBy.value = {{ namespace }}.orderBy.value == 'customer' && {{ namespace }}.sortBy.value == 'asc' ? 'desc' : 'asc'; {{ namespace }}.orderBy.value = 'customer'; {{ datastar.sse('plugin-sales/_datastar/sales') }}" data-indicator-fetching-sales>
                            {{ 'Customer'|t('plugin-sales') }}
                        </button>
                    </th>
                {% endif %}
                <th class="orderable" data-class="{'ordered': {{ namespace }}.orderBy.value == 'name', 'desc': {{ namespace }}.sortBy.value == 'desc'}">
                    <button data-on-click="{{ namespace }}.sortBy.value = {{ namespace }}.orderBy.value == 'name' && {{ namespace }}.sortBy.value == 'asc' ? 'desc' : 'asc'; {{ namespace }}.orderBy.value = 'name'; {{ datastar.sse('plugin-sales/_datastar/sales') }}" data-indicator-fetching-sales>
                        {{ 'Plugin'|t('plugin-sales') }}
                    </button>
                </th>
                <th class="orderable" data-class="{'ordered': {{ namespace }}.orderBy.value == 'edition', 'desc': {{ namespace }}.sortBy.value == 'desc'}">
                    <button data-on-click="{{ namespace }}.sortBy.value = {{ namespace }}.orderBy.value == 'edition' && {{ namespace }}.sortBy.value == 'asc' ? 'desc' : 'asc'; {{ namespace }}.orderBy.value = 'edition'; {{ datastar.sse('plugin-sales/_datastar/sales') }}" data-indicator-fetching-sales>
                        {{ 'Edition'|t('plugin-sales') }}
                    </button>
                </th>
                <th class="orderable" data-class="{'ordered': {{ namespace }}.orderBy.value == 'renewal', 'desc': {{ namespace }}.sortBy.value == 'desc'}">
                    <button data-on-click="{{ namespace }}.sortBy.value = {{ namespace }}.orderBy.value == 'renewal' && {{ namespace }}.sortBy.value == 'asc' ? 'desc' : 'asc'; {{ namespace }}.orderBy.value = 'renewal'; {{ datastar.sse('plugin-sales/_datastar/sales') }}" data-indicator-fetching-sales>
                        {{ 'Type'|t('plugin-sales') }}
                    </button>
                </th>
                <th class="orderable" data-class="{'ordered': {{ namespace }}.orderBy.value == 'grossAmount', 'desc': {{ namespace }}.sortBy.value == 'desc'}">
                    <button data-on-click="{{ namespace }}.sortBy.value = {{ namespace }}.orderBy.value == 'grossAmount' && {{ namespace }}.sortBy.value == 'desc' ? 'asc' : 'desc'; {{ namespace }}.orderBy.value = 'grossAmount'; {{ datastar.sse('plugin-sales/_datastar/sales') }}" data-indicator-fetching-sales>
                        {{ 'Gross'|t('plugin-sales') }} ($)
                    </button>
                </th>
                <th class="orderable" data-class="{'ordered': {{ namespace }}.orderBy.value == 'netAmount', 'desc': {{ namespace }}.sortBy.value == 'desc'}">
                    <button data-on-click="{{ namespace }}.sortBy.value = {{ namespace }}.orderBy.value == 'netAmount' && {{ namespace }}.sortBy.value == 'desc' ? 'asc' : 'desc'; {{ namespace }}.orderBy.value = 'netAmount'; {{ datastar.sse('plugin-sales/_datastar/sales') }}" data-indicator-fetching-sales>
                        {{ 'Net'|t('plugin-sales') }} ($)
                    </button>
                </th>
                <th class="orderable" data-class="{'ordered': {{ namespace }}.orderBy.value == 'dateSold', 'desc': {{ namespace }}.sortBy.value == 'desc'}">
                    <button data-on-click="{{ namespace }}.sortBy.value = {{ namespace }}.orderBy.value == 'dateSold' && {{ namespace }}.sortBy.value == 'desc' ? 'asc' : 'desc'; {{ namespace }}.orderBy.value = 'dateSold'; {{ datastar.sse('plugin-sales/_datastar/sales') }}" data-indicator-fetching-sales>
                        {{ 'Date'|t('plugin-sales') }}
                    </button>
                </th>
            </tr>
        </thead>
        {{ include('plugin-sales/_includes/sales-results') }}
    </table>
    <div class="centeralign hidden">
        <div class="spinner loadingmore"></div>
    </div>
    <div id="footer" class="flex flex-justify">
        <div id="count-spinner" class="spinner small hidden"></div>
        <div id="count-container" class="light">
            <div class="flex pagination">
                <nav class="flex">
                    <button data-show="{{ namespace }}.offset.value > 0" data-on-click="{{ namespace }}.offset.value = {{ namespace }}.offset.value - {{ namespace }}.limit.value; {{ datastar.sse('plugin-sales/_datastar/sales') }}" data-indicator-fetching-sales class="page-link prev-page" title="Previous Page" style="display: none"></button>
                    <button data-show="{{ namespace }}.offset.value <= 0" class="page-link prev-page disabled" title="Previous Page"></button>
                    <button data-show="{{ namespace }}.maxVisible.value < {{ namespace }}.total.value" data-on-click="{{ namespace }}.offset.value = {{ namespace }}.offset.value + {{ namespace }}.limit.value; {{ datastar.sse('plugin-sales/_datastar/sales') }}" data-indicator-fetching-sales class="page-link next-page" title="Next Page" style="display: none"></button>
                    <button data-show="{{ namespace }}.maxVisible.value >= {{ namespace }}.total.value" class="page-link next-page disabled" title="Next Page"></button>
                </nav>
                <div class="page-info">
                    <span data-text="{{ namespace }}.maxVisible.value > 0 ? {{ namespace }}.offset.value + 1 : 0">0</span>-<span data-text="{{ namespace }}.maxVisible.value">0</span>
                    of
                    <span data-text="{{ namespace }}.total.value">0</span> sales
                </div>
            </div>
        </div>
    </div>
</div>
