{% set customer = customer ?? signals.customer ?? null %}
{% set salesType = customer ? 'customer' : 'all' %}
{% set namespace = 'sales.' ~ salesType %}

{% set start = customer ? null : (start ?? signals.start ?? null) %}
{% set end = customer ? null : (end ?? signals.end ?? null) %}
{% set limit = signals.sales[salesType].limit %}
{% set search = signals.sales[salesType].search %}
{% set orderBy = signals.sales[salesType].orderBy %}
{% set sortBy = signals.sales[salesType].sortBy %}
{% set offset = offset ?? 0 %}
{% set sales = craft.pluginSales.reports.getSalesData(customer, start, end, orderBy, sortBy, offset, limit, search) %}
{% set total = craft.pluginSales.reports.getSalesCount(customer, start, end, search) %}
{% set maxVisible = sales|length + offset %}

{% do datastar.setSseEventOptions({useViewTransition: false}) %}

<div id="sales-results{{ customer ? '-slideout' }}" class="elements" data-star-class="{'busy': $fetching.sales.{{ customer ? 'customer' : 'all' }}}" style="margin-top: 1rem;">
    <div id="sales-indicator" class="update-spinner spinner spinner-absolute"></div>
    <table class="data fullwidth">
        <thead>
            <tr>
                {% if customer is empty %}
                    <th class="orderable {{ orderBy == 'customer' ? 'ordered' }} {{ sortBy == 'desc' ? 'desc' }}">
                        <button data-star-on-click="${{ namespace }}.sortBy = ${{ namespace }}.orderBy == 'customer' && ${{ namespace }}.sortBy == 'asc' ? 'desc' : 'asc'; ${{ namespace }}.orderBy = 'customer'; {{ datastar.get('plugin-sales/_partials/sales-results') }}" data-star-indicator-fetching.sales.{{ customer ? 'customer' : 'all' }}>
                            {{ 'Customer'|t('plugin-sales') }}
                        </button>
                    </th>
                {% endif %}
                <th class="orderable {{ orderBy == 'name' ? 'ordered' }} {{ sortBy == 'desc' ? 'desc' }}">
                    <button data-star-on-click="${{ namespace }}.orderBy = 'name'; ${{ namespace }}.sortBy = '{{ orderBy == 'name' and sortBy == 'asc' ? 'desc' : 'asc' }}'; {{ datastar.get('plugin-sales/_partials/sales-results') }}" data-star-indicator-fetching.sales.{{ customer ? 'customer'  : 'all' }}>
                        {{ 'Plugin'|t('plugin-sales') }}
                    </button>
                </th>
                <th class="orderable" data-star-class="{'ordered': ${{ namespace }}.orderBy == 'edition', 'desc': ${{ namespace }}.sortBy == 'desc'}">
                    <button data-star-on-click="${{ namespace }}.sortBy = ${{ namespace }}.orderBy == 'edition' && ${{ namespace }}.sortBy == 'asc' ? 'desc' : 'asc'; ${{ namespace }}.orderBy = 'edition'; {{ datastar.get('plugin-sales/_partials/sales-results') }}" data-star-indicator-fetching.sales.{{ customer ? 'customer' : 'all' }}>
                        {{ 'Edition'|t('plugin-sales') }}
                    </button>
                </th>
                <th class="orderable" data-star-class="{'ordered': ${{ namespace }}.orderBy == 'renewal', 'desc': ${{ namespace }}.sortBy == 'desc'}">
                    <button data-star-on-click="${{ namespace }}.sortBy = ${{ namespace }}.orderBy == 'renewal' && ${{ namespace }}.sortBy == 'asc' ? 'desc' : 'asc'; ${{ namespace }}.orderBy = 'renewal'; {{ datastar.get('plugin-sales/_partials/sales-results') }}" data-star-indicator-fetching.sales.{{ customer ? 'customer' : 'all' }}>
                        {{ 'Type'|t('plugin-sales') }}
                    </button>
                </th>
                <th class="orderable" data-star-class="{'ordered': ${{ namespace }}.orderBy == 'grossAmount', 'desc': ${{ namespace }}.sortBy == 'desc'}">
                    <button data-star-on-click="${{ namespace }}.sortBy = ${{ namespace }}.orderBy == 'grossAmount' && ${{ namespace }}.sortBy == 'desc' ? 'asc' : 'desc'; ${{ namespace }}.orderBy = 'grossAmount'; {{ datastar.get('plugin-sales/_partials/sales-results') }}" data-star-indicator-fetching.sales.{{ customer ? 'customer' : 'all' }}>
                        {{ 'Gross'|t('plugin-sales') }} ($)
                    </button>
                </th>
                <th class="orderable" data-star-class="{'ordered': ${{ namespace }}.orderBy == 'netAmount', 'desc': ${{ namespace }}.sortBy == 'desc'}">
                    <button data-star-on-click="${{ namespace }}.sortBy = ${{ namespace }}.orderBy == 'netAmount' && ${{ namespace }}.sortBy == 'desc' ? 'asc' : 'desc'; ${{ namespace }}.orderBy = 'netAmount'; {{ datastar.get('plugin-sales/_partials/sales-results') }}" data-star-indicator-fetching.sales.{{ customer ? 'customer' : 'all' }}>
                        {{ 'Net'|t('plugin-sales') }} ($)
                    </button>
                </th>
                <th class="orderable" data-star-class="{'ordered': ${{ namespace }}.orderBy == 'dateSold', 'desc': ${{ namespace }}.sortBy == 'desc'}">
                    <button data-star-on-click="${{ namespace }}.sortBy = ${{ namespace }}.orderBy == 'dateSold' && ${{ namespace }}.sortBy == 'desc' ? 'asc' : 'desc'; ${{ namespace }}.orderBy = 'dateSold'; {{ datastar.get('plugin-sales/_partials/sales-results') }}" data-star-indicator-fetching.sales.{{ customer ? 'customer' : 'all' }}>
                        {{ 'Date'|t('plugin-sales') }}
                    </button>
                </th>
            </tr>
        </thead>
        <tbody>
            {% for sale in sales %}
                <tr>
                    {% if customer is empty %}
                        <td>
                            <a href="#" onclick="event.preventDefault(); new PluginSales.CustomerSlideout('{{ sale.customer }}')">
                                {{- sale.customer -}}
                            </a>
                            {% if sale.first %}
                                <span title="{{ 'First plugin license purchase.'|t('plugin-sales') }}" class="icon">
                            {{ svg('@putyourlightson/pluginsales/resources/icons/excite.svg') }}
                        </span>
                            {% endif %}
                        </td>
                    {% endif %}
                    <td>
                        {{ sale.name }}
                    </td>
                    <td>
                        {{ sale.edition|capitalize }}
                    </td>
                    <td>
                        {{ sale.renewal ? 'Renewal'|t('plugin-sales') : 'Licence'|t('plugin-sales') }}
                        {% if sale.notice %}
                            <span title="{{ sale.notice }}" class="icon">
                        {{ svg('@putyourlightson/pluginsales/resources/icons/info.svg') }}
                    </span>
                        {% endif %}
                    </td>
                    <td>
                        {{ sale.grossAmount|number(2) }}
                    </td>
                    <td>
                        {{ sale.netAmount|number(2) }}
                    </td>
                    <td>
                        {{ sale.dateSold|datetime }}
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
    <div class="centeralign hidden">
        <div class="spinner loadingmore"></div>
    </div>
    <div id="footer" class="flex flex-justify">
        <div id="count-spinner" class="spinner small hidden"></div>
        <div id="count-container" class="light">
            <div class="flex pagination">
                <nav class="flex">
                    {% if offset > 0 %}
                        <button data-star-on-click="{{ datastar.get('plugin-sales/_partials/sales-results', {offset: offset - limit}) }}" data-star-indicator-fetching.sales.{{ customer ? 'customer'  : 'all' }} class="page-link prev-page" title="Previous Page"></button>
                    {% else %}
                        <button class="page-link prev-page disabled" title="Previous Page"></button>
                    {% endif %}
                    {% if maxVisible < total %}
                        <button data-star-on-click="{{ datastar.get('plugin-sales/_partials/sales-results', {offset: offset + limit}) }}" data-star-indicator-fetching.sales.{{ customer ? 'customer'  : 'all' }} class="page-link next-page" title="Next Page"></button>
                    {% else %}
                        <button class="page-link next-page disabled" title="Next Page"></button>
                    {% endif %}
                </nav>
                <div class="page-info">
                    {{ maxVisible > 0 ? offset + 1 : 0 }}-{{ maxVisible }}
                    of
                    {{ total }} sales
                </div>
            </div>
        </div>
    </div>
</div>
